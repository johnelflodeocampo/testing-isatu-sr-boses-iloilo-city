{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.js": {
      "maxDuration": 30,
      "includeFiles": "{private/**,public/index.html,notice/notice.txt}"
    }
  },
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
